{
  "name": "udink-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "vite build && cp dist/index.html dist/404.html && mkdir -p dist/koma && cp dist/index.html dist/koma/index.html && mkdir -p dist/projects && cp dist/index.html dist/projects/index.html && mkdir -p dist/experience && cp dist/index.html dist/experience/index.html && mkdir -p dist/labs && cp dist/index.html dist/labs/index.html && mkdir -p dist/ide && cp dist/index.html dist/ide/index.html && mkdir -p dist/contact && cp dist/index.html dist/contact/index.html",
    "build:full": "tsc && vite build && esbuild server.ts --bundle --platform=node --outdir=dist --format=cjs --out-extension:.js=.cjs",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google/genai": "*",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/express": "^5.0.6",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.160.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/three": "^0.160.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.1.1",
    "globals": "^17.5.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.4.1"
  }
}
